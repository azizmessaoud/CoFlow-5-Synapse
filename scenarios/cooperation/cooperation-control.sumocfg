<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="../safety-mask/safety.net.xml"/>
    <route-files value="cooperation.rou.xml"/>
    <additional-files value="cooperation.tls.xml"/>
  </input>
  <time><begin value="0"/><end value="180"/><step-length value="1"/></time>
  <processing><time-to-teleport value="-1"/></processing>
  <report><no-step-log value="true"/><duration-log.disable value="true"/></report>
</configuration>
